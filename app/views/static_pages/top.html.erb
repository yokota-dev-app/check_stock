<div class="top-wrapper">
  <div class="hero-container">
    <!-- 左側：テキストコンテンツ -->
    <div class="hero-content">
      <span class="app-badge">CheckStock</span>
      <h1 class="hero-title">
        準備の「うっかり」をゼロに。<br>
        自分だけのチェックリストを、いつでもストック。
      </h1>
      <p class="hero-description">
        日常のタスクから旅行・出張の持ち物まで、いつもの準備をテンプレート化。<br>
        もう「何か忘れてないかな？」と不安になる必要はありません。
      </p>
      
      <% unless logged_in? %>
        <div class="hero-buttons">
          <%= link_to '新規登録', new_user_path, class: "btn btn-primary" %>
          <%= link_to 'ログイン', login_path, class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>

    <!-- 右側：メインビジュアル画像 -->
    <div class="hero-image">
      <%= image_tag 'template.png', alt: 'CheckStockのイメージイラスト' %>
    </div>
  </div>
</div>