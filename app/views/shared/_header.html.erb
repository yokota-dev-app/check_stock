<header class="site-header">
  <nav class="header-nav">
    <%= link_to lists_path, class: "site-brand" do %>
      CheckStock
    <% end %>

    <ul class="nav-menu">
      <li class="nav-item has-dropdown">
        <%= link_to 'マイリスト', lists_path, class: 'nav-link' %>
      </li>

      <li class="nav-item has-dropdown">
        <%= link_to 'テンプレート', template_lists_path, class: 'nav-link' %>
      </li>

      <li class="nav-item has-dropdown">
        <%= link_to '#', class: 'nav-link profile-link' do %>
          <%= image_tag 'sample.jpg', class: 'profile-icon', width: '40', height: '40', alt: 'プロフィール画像' %>
        <% end %>
        <ul class="dropdown-menu dropdown-menu-right">
          <li class="dropdown-user-name"><%= current_user.decorate.full_name %></li>
          <li class="dropdown-divider"></li>
          <li><%= link_to 'ログアウト', logout_path, class: 'dropdown-item', data: { turbo_method: :delete } %></li>
        </ul>
      </li>
    </ul>
  </nav>
</header>