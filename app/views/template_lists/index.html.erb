<div>
  <% if @template_lists.present? %>
    <% @template_lists.each do |template_list| %>
      <div class="temp">
        <div id="template_list-id-<%= template_list.id %>">
          <div class="template_list">
            <div class="template_list-body">
              <h4 class="template_list-title">
                <%= template_list.title %>
              </h4>
              <% if current_user.own?(template_list) %>
                <%= link_to '削除', template_list_path(template_list),
                      id: "button-delete-#{template_list.id}",
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "削除してもよろしいでしょうか？"
                      }
                %>
              <% end %>
              <p class="template_listd-memo"><%= template_list.memo %></p>
              <%= form_with url: template_list_template_items_path(template_list), scope: :template_item, class: "template_item-add-form" do |template_item_form| %>
                <%= template_item_form.text_field :name,
                      value: @new_template_item_template_list_id == template_list.id ? @new_template_item_name : nil,
                      placeholder: "追加する項目",
                      aria: { label: "追加する項目" }
                %>
                <%= template_item_form.submit "追加" %>
              <% end %>
              <% if @new_template_item_template_list_id == template_list.id && @new_template_item_errors.present? %>
                <p class="template_item-add-errors"><%= @new_template_item_errors.to_sentence %></p>
              <% end %>
              <ul>
                <% template_list.template_items.each do |template_item| %>
                  <li>
                    <%= form_with model: [template_list, template_item], data: {
                          controller: "template_item-autosave",
                          action: "focusout->template_item-autosave#focusout keydown.enter->template_item-autosave#save turbo:submit-end->template_item-autosave#submitted"
                        } do |template_item_form| %>
                      <%= template_item_form.check_box :is_checked,
                            id: "template_item-checked-#{template_item.id}",
                            data: {
                              template_item_autosave_target: "checked",
                              action: "change->template_item-autosave#save"
                            }
                      %>
                      <%= template_item_form.text_field :name,
                            required: true,
                            aria: { label: "チェック項目名" },
                            data: { template_item_autosave_target: "field" }
                      %>
                    <% end %>
                    <%= button_to "削除", template_list_template_item_path(template_list, template_item),
                          method: :delete,
                          id: "button-delete-template_item-#{template_item.id}",
                          class: "template_item-delete-button",
                          form: { data: { turbo_confirm: "この項目を削除しますか？" } }
                    %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div>持ち物リストがありません</div>
  <% end %>
</div>