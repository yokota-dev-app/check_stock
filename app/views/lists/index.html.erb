<main class="lists-page" data-controller="list-selector">
  <% if @lists.present? %>
    <aside class="list-sidebar" aria-label="持ち物リスト一覧">
      <div class="list-sidebar-header">
        <h1>持ち物リスト</h1>
        <div data-controller="dialog">
          <button type="button" class="dialog-open-button" data-action="dialog#open">新規作成</button>
          <dialog class="create-dialog" data-dialog-target="dialog" aria-labelledby="new-list-dialog-title">
            <header class="create-dialog-header">
              <h2 id="new-list-dialog-title">新しい持ち物リスト</h2>
              <button type="button" class="dialog-close-button" data-action="dialog#close" aria-label="閉じる">閉じる</button>
            </header>
            <div class="create-dialog-body">
              <%= render "lists/form" %>
            </div>
          </dialog>
        </div>
      </div>
      <ul class="list-picker-list">
        <% @lists.each_with_index do |list, index| %>
          <li class="list-picker-row">
            <button type="button"
                    class="list-picker-option"
                    data-list-selector-target="option"
                    data-list-id="<%= list.id %>"
                    data-action="list-selector#select"
                    aria-pressed="<%= list.id == @selected_list_id %>">
              <span class="list-picker-title"><%= list.title %></span>
            </button>
            <%= form_with model: list, class: "list-completion-form", data: {
                  controller: "list-completion",
                  action: "turbo:submit-end->list-completion#submitted"
                } do |completion_form| %>
              <label for="list-completed-<%= list.id %>" class="list-completion-label">
                <%= completion_form.check_box :is_completed,
                      id: "list-completed-#{list.id}",
                      data: {
                        list_completion_target: "checkbox",
                        action: "change->list-completion#save"
                      }
                %>
                        <span><%= list.is_completed? ? "完了" : "アクティブ" %></span>
              </label>
            <% end %>
            <%= button_to "削除", list_path(list),
                  method: :delete,
                  class: "list-delete-button",
                  form: { data: { turbo_confirm: "削除してもよろしいでしょうか？" } }
            %>
          </li>
        <% end %>
      </ul>
    </aside>

    <section class="list-detail-pane" aria-label="選択中のリスト" data-list-selector-target="panels">
      <% @lists.each_with_index do |list, index| %>
        <article class="list-detail" data-list-selector-target="panel" data-list-id="<%= list.id %>" <% unless list.id == @selected_list_id %>hidden<% end %>>
          <header class="list-detail-header">
            <%= form_with model: list, class: "list-detail-edit-form", data: {
                  controller: "detail-autosave",
                  action: "focusout->detail-autosave#focusout turbo:submit-end->detail-autosave#submitted"
                } do |list_form| %>
              <div class="list-detail-edit-field">
                <%= list_form.label :title, "タイトル" %>
                <%= list_form.text_field :title,
                      required: true,
                      class: "list-detail-title-input",
                      data: {
                        detail_autosave_target: "title",
                        action: "keydown.enter->detail-autosave#save"
                      }
                %>
              </div>
              <div class="list-detail-edit-field">
                <%= list_form.label :memo, "メモ" %>
                <%= list_form.text_area :memo,
                      rows: 3,
                      class: "list-detail-memo-input",
                      data: { detail_autosave_target: "memo" }
                %>
              </div>
            <% end %>
            <%= button_to "テンプレート化", make_template_list_path(list),
                  method: :post,
                  class: "list-template-button",
                  form: { data: { turbo_confirm: "テンプレート化してもよろしいでしょうか？" } }
            %>
          </header>

          <%= form_with url: list_items_path(list), scope: :item, class: "item-add-form" do |item_form| %>
            <%= item_form.text_field :name,
                  value: @new_item_list_id == list.id ? @new_item_name : nil,
                  placeholder: "追加する項目",
                  aria: { label: "追加する項目" }
            %>
            <%= item_form.submit "追加" %>
          <% end %>
          <% if @new_item_list_id == list.id && @new_item_errors.present? %>
            <p class="item-add-errors"><%= @new_item_errors.to_sentence %></p>
          <% end %>
          <ul class="list-detail-items">
            <% list.items.each do |item| %>
              <li class="list-detail-item">
                <%= form_with model: [list, item], data: {
                      controller: "item-autosave",
                      action: "focusout->item-autosave#focusout keydown.enter->item-autosave#save turbo:submit-end->item-autosave#submitted"
                    } do |item_form| %>
                  <%= item_form.check_box :is_checked,
                        id: "item-checked-#{item.id}",
                        data: {
                          item_autosave_target: "checked",
                          action: "change->item-autosave#save"
                        }
                  %>
                  <%= item_form.text_field :name,
                        required: true,
                        aria: { label: "チェック項目名" },
                        data: { item_autosave_target: "field" }
                  %>
                <% end %>
                <%= button_to "削除", list_item_path(list, item),
                      method: :delete,
                      id: "button-delete-item-#{item.id}",
                      class: "item-delete-button",
                      form: { data: { turbo_confirm: "この項目を削除しますか？" } }
                %>
              </li>
            <% end %>
          </ul>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="list-empty-state">
      <h1>持ち物リスト</h1>
      <p>持ち物リストがありません</p>
      <div data-controller="dialog">
        <button type="button" class="dialog-open-button" data-action="dialog#open">新規作成</button>
        <dialog class="create-dialog" data-dialog-target="dialog" aria-labelledby="new-list-dialog-title">
          <header class="create-dialog-header">
            <h2 id="new-list-dialog-title">新しい持ち物リスト</h2>
            <button type="button" class="dialog-close-button" data-action="dialog#close" aria-label="閉じる">閉じる</button>
          </header>
          <div class="create-dialog-body">
            <%= render "lists/form" %>
          </div>
        </dialog>
      </div>
    </section>
  <% end %>
</main>