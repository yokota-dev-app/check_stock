<div>
  <% if @lists.present? %>
    <% @lists.each do |list| %>
      <div class="temp">
        <div id="list-id-<%= list.id %>">
          <div class="list">
            <div class="list-body">
              <h4 class="list-title">
                <%= list.title %>
              </h4>
              <% if current_user.own?(list) %>
                <%= link_to '削除', list_path(list),
                      id: "button-delete-#{list.id}",
                      data: {
                        turbo_method: :delete,
                        turbo_confirm: "削除してもよろしいでしょうか？"
                      }
                %>
              <% end %>
              <p class="listd-memo"><%= list.memo %></p>
              <ul>
                <% list.items.each do |item| %>
                  <li>
                    <label>
                      <%= check_box_tag "item_#{item.id}", "1", item.is_checked %>
                      <%= item.name %>
                    </label>
                    <%= button_to "削除", list_item_path(list, item),
                          method: :delete,
                          id: "button-delete-item-#{item.id}",
                          class: "item-delete-button",
                          form: { data: { turbo_confirm: "この項目を削除しますか？" } }
                    %>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div>持ち物リストがありません</div>
  <% end %>
</div>