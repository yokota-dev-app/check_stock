<div>
  <% if @lists.present? %>
    <% @lists.each do |list| %>
      <div class="temp">
        <div id="list-id-<%= list.id %>">
          <div class="list">
            <div class="list-body">
              <h4 class="list-title">
                <%= list.title %>
              </h4>
              <p class="listd-memo"><%= list.memo %></p>
              <ul>
                <li><label><input type="checkbox"> 項目 1</label></li>
                <li><label><input type="checkbox"> 項目 2</label></li>
                <li><label><input type="checkbox" checked> 最初からチェック済みの項目</label></li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div>持ち物リストがありません</div>
  <% end %>
</div>