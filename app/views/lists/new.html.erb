<div class="container">
  <div class="row">
    <div class="col-lg-8 offset-lg-2">
      <h1>新規リスト作成</h1>
      <%= form_with model: @list, class: "new_list" do |f| %>
        <div class="mb-3">
          <%= f.label :title %>
          <%= f.text_field :title, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :memo %>
          <%= f.text_area :memo, class: "form-control", rows: "10" %>
        </div>
        <%= f.submit nil, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>
</div>